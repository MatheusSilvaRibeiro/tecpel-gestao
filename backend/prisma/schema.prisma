generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VENDEDOR
}

enum ProductType {
  PERFUME
  CREAM
}

enum StockMovementType {
  ENTRY
  ADJUSTMENT
  SALE
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
  OTHER
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         UserRole @default(VENDEDOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements StockMovement[]
  sales          Sale[]
  purchases      Purchase[]
}

model Product {
  id             String          @id @default(uuid())
  name           String
  brand          String?
  description    String?
  type           ProductType
  salePrice      Decimal         @db.Decimal(10, 2)
  imageUrl       String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@index([name])
  @@index([type])
  @@index([active])
}

model StockMovement {
  id             String            @id @default(uuid())
  productId      String
  type           StockMovementType
  quantity       Int
  unitCost       Decimal?          @db.Decimal(10, 2)
  note           String?
  createdBy      String
  createdAt      DateTime          @default(now())
  purchaseItemId String?           @unique

  product      Product       @relation(fields: [productId], references: [id])
  user         User          @relation(fields: [createdBy], references: [id])
  purchaseItem PurchaseItem? @relation(fields: [purchaseItemId], references: [id])

  @@index([productId, createdAt])
  @@index([createdBy])
}

model Purchase {
  id            String   @id @default(uuid())
  supplierName  String?
  invoiceNumber String?
  purchaseDate  DateTime
  totalAmount   Decimal  @db.Decimal(10, 2)
  createdById   String
  createdAt     DateTime @default(now())

  createdBy User           @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@index([purchaseDate])
  @@index([createdById])
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Decimal @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  purchase      Purchase       @relation(fields: [purchaseId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  stockMovement StockMovement?

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id            String        @id @default(uuid())
  soldById      String
  paymentMethod PaymentMethod
  totalAmount   Decimal       @db.Decimal(10, 2)
  totalCost     Decimal       @db.Decimal(10, 2)
  totalProfit   Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())

  soldBy User       @relation(fields: [soldById], references: [id])
  items  SaleItem[]

  @@index([createdAt])
  @@index([soldById])
  @@index([paymentMethod])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  profit    Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}
